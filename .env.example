# Copie para .env e ajuste. NUNCA faça commit do .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# URL pública usada para montar os links curtos (sem barra final)
BASE_URL=http://localhost:3000

# Conexão com o PostgreSQL (desenvolvimento local; ver README)
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener

# Chave exigida no header x-api-key para criar/listar/remover links e ver estatísticas.
# Obrigatória em produção (mín. 16 caracteres). Gere com: openssl rand -hex 24
API_KEY=

# Segredo usado no hash dos visitantes (HMAC-SHA256). Obrigatório em produção (mín. 16 caracteres).
# Gere com: openssl rand -hex 24
IP_HASH_SALT=

# Use true somente atrás de um proxy reverso confiável (Nginx, Traefik, Cloudflare...)
TRUST_PROXY=false

# Executa as migrations ao iniciar o servidor
AUTO_MIGRATE=true

# Tamanho dos códigos gerados automaticamente (4 a 16)
CODE_LENGTH=7

# Header com o código do país do visitante (ex.: cf-ipcountry no Cloudflare).
# Só é confiável se o proxy sobrescreve esse header. Deixe vazio para desativar.
COUNTRY_HEADER=

LOG_LEVEL=info

# Apenas para docker compose
POSTGRES_PASSWORD=
